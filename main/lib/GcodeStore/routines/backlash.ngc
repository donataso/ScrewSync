o<backlash> sub
(Backlash: touch, then reverse until the contact opens, #3 times.)
(#1: axis, 0 = Z, 1 = X. #2: direction, -1 or 1. #3: runs.)
(Prints "backlash <mm>": the average motor travel to open the contact.)
(Leaves G21 G90 active.)
o100 if [#<_probe_dst> LE 0]
  (ABORT, set probe distance)
o100 endif
o101 if [#3 LT 1]
  (ABORT, runs must be 1 or more)
o101 endif
G21
#<back> = #<_probe_back_off>
#<z> = [#2 * [#1 EQ 0]]
#<x> = [#2 * [#1 EQ 1]]
#<dist> = #<_probe_dst>
#<feed> = #<_probe_feed>
#<sum> = 0
G91
o102 repeat [#3]
  (MSG, touch)
  o103 if [#1 EQ 0]
    G38.2 Z[#2 * #<dist>] F#<feed>
  o103 else
    G38.2 X[#2 * #<dist>] F#<feed>
  o103 endif
  #<contact> = #<_probe_motor>
  (MSG, release)
  o104 if [#1 EQ 0]
    G38.4 Z[-#2 * #<back>] F#<_reprobe_feed>
  o104 else
    G38.4 X[-#2 * #<back>] F#<_reprobe_feed>
  o104 endif
  #<sum> = [#<sum> + ABS[#<_probe_motor> - #<contact>]]
  (MSG, back off)
  G1 Z[-#<z> * #<back>] X[-#<x> * #<back>] F#<_reprobe_feed>
  #<dist> = [#<back> + 0.5]
  #<feed> = #<_reprobe_feed>
o102 endrepeat
#<average> = [#<sum> / #3]
(PRINT, backlash #<average>)
G90
o<backlash> endsub

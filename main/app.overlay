/* Z/X stepper step pulses, each from its own General Purpose Timer (TIMG1
 * T0/T1 -- TIMG0 is reserved for the Wi-Fi stack's RTC slow-clock
 * calibration), prescaled to a 1MHz tick so 1 tick = 1us in Stepper.cpp's
 * ramp math. */
&timer2 {
	status = "okay";
	prescaler = <80>;

	counter {
		status = "okay";
	};
};

&timer3 {
	status = "okay";
	prescaler = <80>;

	counter {
		status = "okay";
	};
};

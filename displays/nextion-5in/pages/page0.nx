include "lib/block.nx"
include "lib/link.nx"
include "page0/axes.nx"
include "page0/keypad.nx"
include "page0/menu.nx"
include "page0/panel.nx"

const HOME_ALL = 1
const HOME_BUSY = 2
const HOME_NO_SENSORS = 3

// sendme tells the firmware the page changed, so it pushes this page.
on page0.load:
  sendme
  // Per-component vis is slow on the panel: hide all, then show the base.
  // Components are global, so the panel lays out from the kept cell kinds.
  vis 255,0
  vis hdrBg,1
  vis rpm,1
  vis rpmUnit,1
  vis angle,1
  vis mode,1
  vis leftBg,1
  vis zEnable,1
  vis zPosBg,1
  vis zPos,1
  vis zZero,1
  vis xEnable,1
  vis xPosBg,1
  vis xPos,1
  vis xZero,1
  vis step0,1
  vis step1,1
  vis step2,1
  vis stepCustom,1
  vis zMinus,1
  vis zPlus,1
  vis xMinus,1
  vis xPlus,1
  vis modeSync,1
  vis toastShow,1
  vis layoutSync,1
  vis toastHide,1
  vis estopBtn,1
  vis estopSync,1
  menuOpen = 0
  settingsOpen = 0
  kpRightOpen = 0
  kpOpen = 0
  layoutPanel(1)
  setTpiEntry(tpiEntry.val)
  linkAge = 0
  blockState.val = BLOCK_NONE
  updateBlock()
  setEstopUi(estop.val)
  setHomeUi()

on page0.up:
  jogCancel()

function setWcs(shown: number):
  vis wcsDismiss,shown
  vis wcsBg,shown
  vis wcs0,shown
  vis wcs1,shown
  vis wcs2,shown
  vis wcs3,shown
  vis wcs4,shown
  vis wcs5,shown
  if (!shown) {
    ref 0
  }

function setEstopUi(on: number):
  vis estopShade,on
  vis estopTouch,on
  if (on) {
    estopBtn.pic = @pic(icons/estop)
    setWcs(0)
  } else {
    estopBtn.pic = @pic(icons/estop_ok)
  }

function setHomeUi():
  var shown = homeState.val != HOME_NO_SENSORS ? 1 : 0
  vis homeBtn,shown
  vis wcsBtn,shown
  if (homeState.val == HOME_BUSY) {
    homeBtn.pic = @pic(icons/home_busy)
  } else if (homeState.val == HOME_ALL) {
    homeBtn.pic = @pic(icons/home_all)
  } else {
    homeBtn.pic = @pic(icons/home_none)
  }

function pickWcs(name: text):
  send("@" + name)
  setWcs(0)

function setToast(shown: number):
  vis toastShade,shown
  vis toast,shown
  vis toastHint,shown
  vis toastDismiss,shown

function hideToast():
  tmToast.en = 0
  setToast(0)
  ref 0

// Clicked by the firmware after it sets toast.txt. While shown, a
// full-screen hotspot takes the next tap so it only dismisses.
on toastShow.down:
  jogCancel()
  setToast(1)
  tmToast.en = 1

on toastDismiss.up:
  hideToast()

on estopSync.down:
  jogCancel()
  setEstopUi(estop.val)

on estopBtn.up:
  send(estop.val ? "estop off" : "estop on")

on homeBtn.up:
  send("home")

on wcsBtn.up:
  if (menuOpen) {
    setMenu(0)
  }
  setWcs(1)

on wcsDismiss.up:
  setWcs(0)

on wcs0.up:
  pickWcs(wcs0.txt)

on wcs1.up:
  pickWcs(wcs1.txt)

on wcs2.up:
  pickWcs(wcs2.txt)

on wcs3.up:
  pickWcs(wcs3.txt)

on wcs4.up:
  pickWcs(wcs4.txt)

on wcs5.up:
  pickWcs(wcs5.txt)

on toastHide.down:
  hideToast()

on tmToast.timer:
  hideToast()

on angle.up:
  send("@M110")

include "lib/block.nx"
include "lib/link.nx"

// Slots the firmware left empty stay hidden.
function layoutPicker():
  var v = 0
  v = tabCmd0.txt != "" ? 1 : 0
  vis tab0,v
  v = tabCmd1.txt != "" ? 1 : 0
  vis tab1,v
  v = tabCmd2.txt != "" ? 1 : 0
  vis tab2,v
  v = tabCmd3.txt != "" ? 1 : 0
  vis tab3,v
  v = tabCmd4.txt != "" ? 1 : 0
  vis tab4,v
  v = tabCmd5.txt != "" ? 1 : 0
  vis tab5,v
  v = tabCmd6.txt != "" ? 1 : 0
  vis tab6,v
  v = tabCmd7.txt != "" ? 1 : 0
  vis tab7,v
  v = tabCmd8.txt != "" ? 1 : 0
  vis tab8,v
  v = gCmd0.txt != "" ? 1 : 0
  vis g0,v
  v = gCmd1.txt != "" ? 1 : 0
  vis g1,v
  v = gCmd2.txt != "" ? 1 : 0
  vis g2,v
  v = gCmd3.txt != "" ? 1 : 0
  vis g3,v
  v = gCmd4.txt != "" ? 1 : 0

  vis g27,v
  v = gCmd28.txt != "" ? 1 : 0
  vis g28,v
  v = gCmd29.txt != "" ? 1 : 0
  vis g29,v
  v = gCmd30.txt != "" ? 1 : 0
  vis g30,v
  v = gCmd31.txt != "" ? 1 : 0
  vis g31,v
  v = gCmd32.txt != "" ? 1 : 0
  vis g32,v
  v = gCmd33.txt != "" ? 1 : 0

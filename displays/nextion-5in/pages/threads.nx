  vis g34,v

// sendme tells the firmware the page changed, so it pushes this page.
on threads.load:
  sendme
  // The firmware's pickerSync lays out the tabs and cells.
  vis 255,0
  vis back,1
  vis pickerSync,1
  linkAge = 0
  blockState.val = BLOCK_NONE

// Clicked by the firmware after the tabs or entries change.
on pickerSync.down:
  layoutPicker()

function pick(designation: text):
  send("thread preset " + pickerGroup.txt + " " + designation)
  page page0

on back.up:
  page page0

on tab0.up:
  send("ui threads " + tabCmd0.txt)

on tab1.up:
  send("ui threads " + tabCmd1.txt)

on tab2.up:
  send("ui threads " + tabCmd2.txt)


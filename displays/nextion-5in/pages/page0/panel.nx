// cKindN, matching CellType in main/lib/Display/Display.cpp.
const KIND_HIDDEN = 0
const KIND_LENGTH = 1
const KIND_PITCH = 2
const KIND_COUNT = 3
const KIND_ANGLE = 4
const KIND_TOGGLE = 5
const KIND_PICKER = 6
const KIND_LATCH = 7
const KIND_PIN = 8
const KIND_HALF = 9
const ZERO_FOR_Z = 1
const ZERO_FOR_X = 2
const ZERO_FOR_CONFIRM = 3
// runView, matching RunState in main/lib/Display/RunView.hpp.
const RUN_ARMED = 1
const NEED_ZERO_OFFER = 1

function overlayOpen() -> number:
  return menuOpen || settingsOpen || kpRightOpen ? 1 : 0

// The mode panel hides under an overlay, so firmware pushes to it can't
// draw over one.
function layoutPanel(shown: number):
  var v = 0
  var cells = shown && !runView.val ? 1 : 0
  v = cells && (cKind0 == KIND_TOGGLE || cKind0 == KIND_HALF) ? 1 : 0
  vis c0a,v
  v = cells && cKind0 == KIND_TOGGLE ? 1 : 0
  vis c0b,v
  v = cells && cKind0 > KIND_HIDDEN && cKind0 != KIND_TOGGLE && cKind0 != KIND_HALF ? 1 : 0
  vis c0,v
  v = cells && (cKind1 == KIND_TOGGLE || cKind1 == KIND_HALF) ? 1 : 0
  vis c1a,v
  v = cells && cKind1 == KIND_TOGGLE ? 1 : 0
  vis c1b,v
  v = cells && cKind1 > KIND_HIDDEN && cKind1 != KIND_TOGGLE && cKind1 != KIND_HALF ? 1 : 0
  vis c1,v
  v = cells && (cKind2 == KIND_TOGGLE || cKind2 == KIND_HALF) ? 1 : 0
  vis c2a,v
  v = cells && cKind2 == KIND_TOGGLE ? 1 : 0
  vis c2b,v
  v = cells && cKind2 > KIND_HIDDEN && cKind2 != KIND_TOGGLE && cKind2 != KIND_HALF ? 1 : 0
  vis c2,v
  v = cells && (cKind3 == KIND_TOGGLE || cKind3 == KIND_HALF) ? 1 : 0
  vis c3a,v
  v = cells && cKind3 == KIND_TOGGLE ? 1 : 0
  vis c3b,v
  v = cells && cKind3 > KIND_HIDDEN && cKind3 != KIND_TOGGLE && cKind3 != KIND_HALF ? 1 : 0
  vis c3,v
  v = cells && (cKind4 == KIND_TOGGLE || cKind4 == KIND_HALF) ? 1 : 0
  vis c4a,v
  v = cells && cKind4 == KIND_TOGGLE ? 1 : 0
  vis c4b,v
  v = cells && cKind4 > KIND_HIDDEN && cKind4 != KIND_TOGGLE && cKind4 != KIND_HALF ? 1 : 0
  vis c4,v
  v = cells && (cKind5 == KIND_TOGGLE || cKind5 == KIND_HALF) ? 1 : 0
  vis c5a,v
  v = cells && cKind5 == KIND_TOGGLE ? 1 : 0
  vis c5b,v
  v = cells && cKind5 > KIND_HIDDEN && cKind5 != KIND_TOGGLE && cKind5 != KIND_HALF ? 1 : 0
  vis c5,v
  v = cells && (cKind6 == KIND_TOGGLE || cKind6 == KIND_HALF) ? 1 : 0
  vis c6a,v
  v = cells && cKind6 == KIND_TOGGLE ? 1 : 0
  vis c6b,v
  v = cells && cKind6 > KIND_HIDDEN && cKind6 != KIND_TOGGLE && cKind6 != KIND_HALF ? 1 : 0
  vis c6,v
  v = cells && (cKind7 == KIND_TOGGLE || cKind7 == KIND_HALF) ? 1 : 0
  vis c7a,v
  v = cells && cKind7 == KIND_TOGGLE ? 1 : 0
  vis c7b,v
  v = cells && cKind7 > KIND_HIDDEN && cKind7 != KIND_TOGGLE && cKind7 != KIND_HALF ? 1 : 0
  vis c7,v
  v = cells && (cKind8 == KIND_TOGGLE || cKind8 == KIND_HALF) ? 1 : 0
  vis c8a,v
  v = cells && cKind8 == KIND_TOGGLE ? 1 : 0
  vis c8b,v
  v = cells && cKind8 > KIND_HIDDEN && cKind8 != KIND_TOGGLE && cKind8 != KIND_HALF ? 1 : 0
  vis c8,v
  v = cells && (cKind9 == KIND_TOGGLE || cKind9 == KIND_HALF) ? 1 : 0
  vis c9a,v
  v = cells && cKind9 == KIND_TOGGLE ? 1 : 0
  vis c9b,v
  v = cells && cKind9 > KIND_HIDDEN && cKind9 != KIND_TOGGLE && cKind9 != KIND_HALF ? 1 : 0
  vis c9,v
  v = cells && cKind10 > KIND_HIDDEN && cKind10 != KIND_PICKER ? 1 : 0
  vis c10,v
  v = cells && cKind11 > KIND_HIDDEN && cKind11 != KIND_PICKER ? 1 : 0
  vis c11,v
  v = cells && cKind12 > KIND_HIDDEN && cKind12 != KIND_PICKER ? 1 : 0
  vis c12,v
  v = cells && cKind13 > KIND_HIDDEN && cKind13 != KIND_PICKER ? 1 : 0
  vis c13,v
  v = cells && cKind14 > KIND_HIDDEN && cKind14 != KIND_PICKER ? 1 : 0
  vis c14,v
  v = cells && cKind15 > KIND_HIDDEN && cKind15 != KIND_PICKER ? 1 : 0
  vis c15,v
  var chrome = shown && !pinsOpen ? 1 : 0
  v = chrome && !runView.val && cKind15 == KIND_PICKER ? 1 : 0
  vis picker,v
  v = chrome && ovrOn.val ? 1 : 0
  vis ovrMinus,v
  vis ovr,v
  vis ovrPlus,v
  var armed = chrome && runView.val == RUN_ARMED ? 1 : 0
  v = chrome && !armed && !canSkip.val && !(gcodeOn.val && gcodePaused.val) && !(probeOn.val && !running.val) ? 1 : 0
  vis startStop,v
  v = chrome && canSkip.val && !(gcodeOn.val && gcodePaused.val) ? 1 : 0
  vis stopPass,v
  v = v || armed ? 1 : 0
  vis skip,v
  vis goStart,armed
  vis startHere,armed
  v = chrome && runView.val && leadInOn.val ? 1 : 0
  vis leadIn,v
  v = chrome && gcodeOn.val && gcodePaused.val ? 1 : 0
  vis gcodeResume,v
  vis gcodeStop,v
  v = chrome && gcodeOn.val && gcodeLoaded.val && picOn.val ? 1 : 0
  vis gcodePic,v
  v = v && gcodeToolOn.val ? 1 : 0
  vis gcodeTool,v
  v = chrome && gcodeOn.val && gcodeLoaded.val ? 1 : 0
  vis gcodeName,v
  vis gcodeProgress,v
  v = chrome && gcodeOn.val && !gcodeLoaded.val ? 1 : 0
  vis gcodeEmpty,v
  v = chrome && probeOn.val ? 1 : 0
  vis probePhase,v
  vis probeUp,v
  vis probeLeft,v
  vis probeLight,v
  vis probeRight,v
  vis probeDown,v

function refreshPanel():
  layoutPanel(overlayOpen() ? 0 : 1)

function openCell(cmd: text, kind: number, slot: number):
  if (kind != KIND_PIN) {
    kpCmd.txt = cmd
    openKeypad(KEYPAD_LEFT, TARGET_CELL, kind, slot)
  }

// A latch cell's command is the flip the firmware set up.
function narrowCell(cmd: text, kind: number, slot: number):
  if (kind == KIND_LATCH) {
    send(cmd)
  } else {
    openCell(cmd, kind, slot)
  }

// A toggle cell's command holds both choices, "a|b".
function sendChoice(cmds: text, index: number):
  spstr cmds,choice.txt,"|",index
  send(choice.txt)

// Clicked by the firmware after a cell kind or canSkip changes.
on layoutSync.down:
  refreshPanel()
  setHomeUi()

on picker.up:
  page threads

function openZeroAsk(target: number):
  zeroFor = target
  if (target == ZERO_FOR_Z) {
    zeroAsk.txt = "Z axis"
    zeroNo.txt = "Set zero"
  } else if (target == ZERO_FOR_X) {
    zeroAsk.txt = "X axis"
    zeroNo.txt = "Set zero"
  } else if (target == ZERO_FOR_CONFIRM) {
    zeroAsk.txt = "Not at zero. Start here?"
    zeroNo.txt = "Start"
  }
  setZeroAsk(1)
  if (target == ZERO_FOR_CONFIRM) {
    vis zeroYes,0
  }

function setZeroAsk(shown: number):
  vis zeroShade,shown
  vis zeroDismiss,shown
  vis zeroPanel,shown
  vis zeroAsk,shown
  vis zeroYes,shown
  vis zeroNo,shown
  vis zeroCancel,shown
  if (!shown) {
    ref 0
  }

on startStop.up:
  if (running.val) {
    send("stop")
  } else if (ready.val && !kpOpen) {
    if (prepares.val) {
      send("ui run on")
    } else if (needZero.val == 2) {
      openZeroAsk(ZERO_FOR_CONFIRM)
    } else {
      send("start")
    }
  }

on goStart.up:
  if (ready.val && needZero.val == NEED_ZERO_OFFER) {
    send("start zero")
  }

on startHere.up:
  if (ready.val) {
    send("start")
  }

on zeroYes.up:
  setZeroAsk(0)
  if (zeroFor == ZERO_FOR_Z) {
    send("o<zero> call [1] [0]")
  } else if (zeroFor == ZERO_FOR_X) {
    send("o<zero> call [0] [1]")
  }

on zeroNo.up:
  setZeroAsk(0)
  if (zeroFor == ZERO_FOR_Z) {
    send("@G10 L20 P0 Z0")
  } else if (zeroFor == ZERO_FOR_X) {
    send("@G10 L20 P0 X0")
  } else {
    send("start")
  }

on zeroCancel.up:
  setZeroAsk(0)

on zeroDismiss.up:
  setZeroAsk(0)

on stopPass.up:
  send("stop")

on skip.up:
  if (runView.val == RUN_ARMED) {
    send("ui run off")
  } else {
    send("skip")
  }

on gcodeResume.up:
  send("start")

on gcodeStop.up:
  send("stop")

on probeUp.up:
  if (xOn.val) {
    send("o<probe> call [1] [-1]")
  }

on probeDown.up:
  if (xOn.val) {
    send("o<probe> call [1] [1]")
  }

on probeLeft.up:
  if (zOn.val) {
    send("o<probe> call [0] [-1]")
  }

on probeRight.up:
  if (zOn.val) {
    send("o<probe> call [0] [1]")
  }

on ovrMinus.up:
  if (running.val) {
    send("override -")
  }

on ovr.up:
  if (running.val) {
    send("override reset")
  }

on ovrPlus.up:
  if (running.val) {
    send("override +")
  }

on c0.up:
  openCell(cCmd0.txt, cKind0, 0)

on c0a.up:
  sendChoice(cCmd0.txt, 0)

on c0b.up:
  sendChoice(cCmd0.txt, 1)

on c1.up:
  openCell(cCmd1.txt, cKind1, 1)

on c1a.up:
  sendChoice(cCmd1.txt, 0)

on c1b.up:
  sendChoice(cCmd1.txt, 1)

on c2.up:
  openCell(cCmd2.txt, cKind2, 2)

on c2a.up:
  sendChoice(cCmd2.txt, 0)

on c2b.up:
  sendChoice(cCmd2.txt, 1)

on c3.up:
  openCell(cCmd3.txt, cKind3, 3)

on c3a.up:
  sendChoice(cCmd3.txt, 0)

on c3b.up:
  sendChoice(cCmd3.txt, 1)

on c4.up:
  openCell(cCmd4.txt, cKind4, 4)

on c4a.up:
  sendChoice(cCmd4.txt, 0)

on c4b.up:
  sendChoice(cCmd4.txt, 1)

on c5.up:
  openCell(cCmd5.txt, cKind5, 5)

on c5a.up:
  sendChoice(cCmd5.txt, 0)

on c5b.up:
  sendChoice(cCmd5.txt, 1)

on c6.up:
  openCell(cCmd6.txt, cKind6, 6)

on c6a.up:
  sendChoice(cCmd6.txt, 0)

on c6b.up:
  sendChoice(cCmd6.txt, 1)

on c7.up:
  openCell(cCmd7.txt, cKind7, 7)

on c7a.up:
  sendChoice(cCmd7.txt, 0)

on c7b.up:
  sendChoice(cCmd7.txt, 1)

on c8.up:
  openCell(cCmd8.txt, cKind8, 8)

on c8a.up:
  sendChoice(cCmd8.txt, 0)

on c8b.up:
  sendChoice(cCmd8.txt, 1)

on c9.up:
  openCell(cCmd9.txt, cKind9, 9)

on c9a.up:
  sendChoice(cCmd9.txt, 0)

on c9b.up:
  sendChoice(cCmd9.txt, 1)

on c10.up:
  narrowCell(cCmd10.txt, cKind10, 10)

on c11.up:
  narrowCell(cCmd11.txt, cKind11, 11)

on c12.up:
  narrowCell(cCmd12.txt, cKind12, 12)

on c13.up:
  narrowCell(cCmd13.txt, cKind13, 13)

on c14.up:
  narrowCell(cCmd14.txt, cKind14, 14)

on c15.up:
  narrowCell(cCmd15.txt, cKind15, 15)

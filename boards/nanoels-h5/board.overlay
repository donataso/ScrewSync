#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>
#include <dt-bindings/screwsync/pins.h>

&psram0 {
	status = "okay";
	size = <DT_SIZE_M(8)>;
};

&flash0 {
	partitions {
		/* Saved G-code programs (LittleFS). */
		gcode_partition: partition@700000 {
			compatible = "zephyr,mapped-partition";
			label = "gcode";
			reg = <0x700000 DT_SIZE_M(1)>;
		};
	};
};

&usb_serial {
	status = "okay";
};

/ {
	chosen {
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
	};

	/* Laid out like the connectors on the back of the case. */
	connectors {
		compatible = "screwsync,connectors";
		board-name = "nanoels H5";
		strapping-gpios = <0 3 45 46>;
		reserved-gpios = <35 36 37>;
		reserved-notes = "octal PSRAM data line inside the chip package. Driving it corrupts the PSRAM and breaks Wi-Fi",
				 "octal PSRAM data line inside the chip package. Driving it corrupts the PSRAM and breaks Wi-Fi",
				 "octal PSRAM data line inside the chip package. Driving it corrupts the PSRAM and breaks Wi-Fi";

		z-motor = <16 15 7>;
		x-motor = <1 2 17>;
		spindle = <10 11>;
		z-handwheel = <21 47>;
		x-handwheel = <3 46>;
		probe = <8>;

		r1c1 { title = "Spare 1"; row = <1>; col = <1>; pins = <PIN_5V 41 42 35>; };
		r1c2 { title = "Z motor"; row = <1>; col = <2>; pins = <PIN_5V 16 15 7>; };
		r1c3 { title = "X motor"; row = <1>; col = <3>; pins = <PIN_5V 1 2 17>; };
		r1c4 { title = "Spare 2"; row = <1>; col = <4>; pins = <38 6 5 4>; };
		r1c5 { title = "Spare 3"; row = <1>; col = <5>; pins = <PIN_5V PIN_GND 36 37>; };
		r2c1 { title = "PROBE"; row = <2>; col = <1>; pins = <PIN_5V PIN_GND 8 18>; };
		r2c2 { title = "Z handwheel"; row = <2>; col = <2>; pins = <PIN_5V PIN_GND 21 47>; };
		r2c3 { title = "X handwheel"; row = <2>; col = <3>; pins = <PIN_5V PIN_GND 3 46>; };
		r2c4 { title = "POWER"; row = <2>; col = <4>; pins = <PIN_5V PIN_5V PIN_GND PIN_GND>; };
		r2c5 { title = "Spare 4"; row = <2>; col = <5>; pins = <PIN_5V PIN_GND 14 13>; };
		r3c1 { title = "Spare 5"; row = <3>; col = <1>; pins = <PIN_5V PIN_GND 12 9>; };
		r3c2 { title = "Spare 6"; row = <3>; col = <2>; pins = <PIN_5V PIN_GND 39 40>; };
		r3c3 { title = "Spare 7"; row = <3>; col = <3>; pins = <PIN_5V PIN_GND 48 45>; };
		r3c4 { title = "POWER"; row = <3>; col = <4>; pins = <PIN_5V PIN_5V PIN_GND PIN_GND>; };
		r3c5 { title = "ENCODER"; row = <3>; col = <5>; pins = <PIN_5V PIN_GND 10 11>; };
	};
};

/* PCNT units for hardware quadrature decoding. Unit 0 is the spindle
 * (read via the driver's interrupt, main/lib/Encoder); the others are
 * handwheels (polled, main/lib/Handwheel), which count the edges of both
 * A and B to cancel contact bounce. The pins below are only the
 * boot routing: main/lib/Pins routes the units and sets their glitch
 * filters from the pin map. */
&pinctrl {
	pcnt_default: pcnt_default {
		group1 {
			pinmux = <PCNT0_CH0SIG_GPIO10>,
				 <PCNT0_CH0CTRL_GPIO11>,
				 <PCNT1_CH0SIG_GPIO47>,
				 <PCNT1_CH0CTRL_GPIO21>,
				 <PCNT2_CH0SIG_GPIO46>,
				 <PCNT2_CH0CTRL_GPIO3>;
			bias-pull-up;
		};
	};
};

&pcnt {
	pinctrl-0 = <&pcnt_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	unit0@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;

		channelA@0 {
			reg = <0>;
			sig-pos-mode = <1>; /* increase on rising edge */
			sig-neg-mode = <2>; /* decrease on falling edge */
			ctrl-h-mode = <1>;  /* invert direction when control is high */
			ctrl-l-mode = <0>;
		};
	};

	unit1@1 {
		reg = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		channelA@0 {
			reg = <0>;
			sig-pos-mode = <1>;
			sig-neg-mode = <2>;
			ctrl-h-mode = <1>;
			ctrl-l-mode = <0>;
		};

		channelB@1 {
			reg = <1>;
			sig-pos-mode = <1>;
			sig-neg-mode = <2>;
			ctrl-h-mode = <0>;
			ctrl-l-mode = <1>;
		};
	};

	unit2@2 {
		reg = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		channelA@0 {
			reg = <0>;
			sig-pos-mode = <1>;
			sig-neg-mode = <2>;
			ctrl-h-mode = <1>;
			ctrl-l-mode = <0>;
		};

		channelB@1 {
			reg = <1>;
			sig-pos-mode = <1>;
			sig-neg-mode = <2>;
			ctrl-h-mode = <0>;
			ctrl-l-mode = <1>;
		};
	};

	unit3@3 {
		reg = <3>;
		#address-cells = <1>;
		#size-cells = <0>;

		channelA@0 {
			reg = <0>;
			sig-pos-mode = <1>;
			sig-neg-mode = <2>;
			ctrl-h-mode = <1>;
			ctrl-l-mode = <0>;
		};

		channelB@1 {
			reg = <1>;
			sig-pos-mode = <1>;
			sig-neg-mode = <2>;
			ctrl-h-mode = <0>;
			ctrl-l-mode = <1>;
		};
	};
};
